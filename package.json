{
  "name": "mochios-app-store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "api:check": "cargo check --manifest-path api/Cargo.toml --target wasm32-unknown-unknown",
    "api:test": "cargo test --manifest-path api/Cargo.toml --lib",
    "api:dev": "cd api && wrangler dev",
    "api:migrate:local": "wrangler d1 migrations apply mochios-app-store --local --config api/wrangler.jsonc",
    "api:migrate:remote": "wrangler d1 migrations apply mochios-app-store --remote --config api/wrangler.jsonc",
    "api:deploy": "cd api && wrangler deploy"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "typescript": "6.0.3",
    "wrangler": "4.114.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3",
    "minimatch": "10.2.5"
  }
}
