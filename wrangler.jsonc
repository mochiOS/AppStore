{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mochios-app-store",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APPSTORE_API_BASE_URL": "https://api.store.mochios.org/v1"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "store.mochios.org",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "rules": [
    {
      "type": "Text",
      "globs": ["**/_not-found.html"],
      "fallthrough": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "mochios-app-store-cache"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "mochios-app-store"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler"
      }
    ]
  },
  "migrations": [
    {
      "tag": "storefront-cache-v1",
      "new_sqlite_classes": ["DOQueueHandler"]
    }
  ]
}
