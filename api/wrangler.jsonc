{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "mochios-app-store-api",
  "main": "build/worker/shim.mjs",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "build": {
    "command": "worker-build --release --no-panic-recovery"
  },
  "routes": [
    {
      "pattern": "api.store.mochios.org",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mochios-app-store",
      "database_id": "9b36ae65-d387-4fd6-85f3-d37a75db6eac",
      "migrations_dir": "migrations"
    }
  ],
  "services": [
    {
      "binding": "ACCOUNTS",
      "service": "mochios-accounts"
    },
    {
      "binding": "DEVELOPER_CA",
      "service": "mochios-developer-ca"
    }
  ],
  "triggers": {
    "crons": ["17 */6 * * *"]
  },
  "ratelimits": [
    {
      "name": "PUBLIC_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 300, "period": 60 }
    },
    {
      "name": "MUTATION_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "REVIEWER_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
